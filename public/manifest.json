{
  "manifest_version": 3,
  "name": "Vidulum App",
  "version": "1.0.0",
  "description": "Vidulum multi-chain wallet interface.",
  "background": { "service_worker": "background/service-worker.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/inject.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
