{
  "manifest_version": 3,
  "name": "Vidulum Wallet",
  "version": "1.0.0",
  "description": "Self-custody wallet for digital assets.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background/service-worker.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/inpage.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_icon": { "128": "icons/icon128.png" } }
}
