{
  "name": "vidulum-app",
  "version": "1.0.0",
  "private": true,
  "description": "Vidulum wallet application",
  "scripts": {
    "dev": "node scripts/copy-static.js && webpack --mode development --watch",
    "dev:web": "bash scripts/dev-web.sh",
    "build": "node scripts/copy-static.js && webpack --mode production",
    "test": "jest",
    "lint": "eslint src scripts --ext .ts,.tsx,.js",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "sync:chain-registry": "ts-node scripts/sync-chain-registry.ts",
    "sync:evm-registry": "ts-node scripts/sync-evm-registry.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
